  "fixed_sql": [
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"path\" TEXT NOT NULL UNIQUE, \"favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"favorite\" IN (0, 1)), \"technologies\" TEXT NOT NULL DEFAULT '[]', \"created_at\" TEXT NOT NULL, \"last_opened_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "project_targets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"project_targets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"project_id\" INTEGER NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"target_id\" TEXT NOT NULL, \"detected\" INTEGER NOT NULL DEFAULT 0 CHECK (\"detected\" IN (0, 1)), \"confirmed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"confirmed\" IN (0, 1)), \"confidence\" REAL NOT NULL DEFAULT 0.0, \"evidence\" TEXT NOT NULL DEFAULT '[]', UNIQUE (\"project_id\", \"target_id\"));"
        }
      ]
    },
    {
      "name": "release_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"release_sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"project_id\" INTEGER NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"version\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"current_level\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"completed_at\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "checklist_steps",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"checklist_steps\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" INTEGER NOT NULL REFERENCES release_sessions (id) ON DELETE CASCADE, \"step_key\" TEXT NOT NULL, \"target_id\" TEXT NULL, \"level\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"note\" TEXT NULL, \"updated_at\" TEXT NOT NULL, UNIQUE (\"session_id\", \"step_key\"));"
        }
      ]
    },
    {
      "name": "session_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"session_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" INTEGER NOT NULL REFERENCES release_sessions (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"entry_key\" TEXT NOT NULL, \"content\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "detection_reports",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"detection_reports\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"project_id\" INTEGER NOT NULL UNIQUE REFERENCES projects (id) ON DELETE CASCADE, \"scanned_at\" TEXT NOT NULL, \"report\" TEXT NOT NULL, \"targets_reviewed_at\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "command_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"command_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"project_id\" INTEGER NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"executable\" TEXT NOT NULL, \"arguments\" TEXT NOT NULL, \"working_directory\" TEXT NOT NULL, \"risk\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"exit_code\" INTEGER NULL, \"started_at\" TEXT NOT NULL, \"duration_ms\" INTEGER NOT NULL DEFAULT 0, \"output\" TEXT NOT NULL DEFAULT '');"
        }
      ]
    },
    {
      "name": "file_changes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"file_changes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"project_id\" INTEGER NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"batch_id\" TEXT NOT NULL, \"label\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"existed_before\" INTEGER NOT NULL CHECK (\"existed_before\" IN (0, 1)), \"backup_path\" TEXT NULL, \"before_hash\" TEXT NULL, \"after_hash\" TEXT NOT NULL, \"applied_at\" TEXT NOT NULL, \"restored_at\" TEXT NULL);"
        }
      ]
